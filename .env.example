# ============================================================
# VARIABLES DE ENTORNO — BDT EVM Backend (.NET)
# Copiá este archivo como .env y completá los valores
# ============================================================

# ── Base de datos ────────────────────────────────────────────
DB_CONNECTION_STRING=Server=host.docker.internal;Port=3306;Database=pm_clockify_evm;User=bdt_user;Password=tu_password;

# ── Clockify ────────────────────────────────────────────────
CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=
CLOCKIFY_USER_ID=

# ── Entorno de la app ────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000
